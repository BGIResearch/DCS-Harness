{
  "name": "dsh-dcs-cloud",
  "version": "2.17.3",
  "description": "DeepSeek Harness 插件：接入 BGI Research 的 dcs CLI，面向 DCS Cloud 的基因组/时空组学生信研究编排 —— 数据检索、Genpilot 流程复用、DCS 原生 skill/专家、在线容器、离线任务投递、脚本审计与学术报告生成。",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "cordis",
    "plugin",
    "dcs",
    "dcs-cloud",
    "genomics",
    "bioinformatics",
    "spatial-omics",
    "stomics",
    "bgi"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "docs",
    "assets"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BGIResearch/DCS-Harness.git"
  },
  "bugs": {
    "url": "https://github.com/BGIResearch/DCS-Harness/issues"
  },
  "homepage": "https://github.com/BGIResearch/DCS-Harness#readme",
  "scripts": {
    "check": "node scripts/check-hooks.cjs",
    "precommit": "npm run check",
    "test": "node test/compat/run.mjs",
    "test:compat": "node test/compat/run.mjs",
    "test:compat:json": "node test/compat/run.mjs --json",
    "test:unit": "node test/compat/run.mjs -l unit",
    "test:contract": "node test/compat/run.mjs -l contract",
    "test:integration": "node test/compat/run.mjs -l integration",
    "test:lifecycle": "node test/compat/run.mjs -l lifecycle",
    "test:upgrade": "node test/compat/run.mjs -l upgrade",
    "test:frozen": "node test/compat/run.mjs -l frozen",
    "test:meta": "node test/compat/run.mjs -l meta",
    "test:matrix": "bash test/compat/matrix.sh",
    "test:e2e": "DCS_E2E=1 node test/compat/run.mjs -l e2e",
    "test:client": "node test/compat/run.mjs -l client-render",
    "test:http": "node test/compat/run.mjs -l http",
    "test:consistency": "node test/compat/run.mjs -l consistency",
    "test:embedded": "node test/compat/run.mjs -l embedded",
    "test:fast": "DSH_FAST=1 node test/compat/run.mjs"
  },
  "dependencies": {},
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compat": {
      "tested": "0.1.6-alpha.1",
      "testedTools": "0.1.6-alpha.1",
      "min": "0.1.1-rc.2",
      "verified": [
        "0.1.6-alpha.1",
        "0.1.5-rc.2",
        "0.1.5-rc.1",
        "0.1.5-alpha.1"
      ],
      "note": "运行 node test/compat/run.mjs 校验当前 dsh 是否仍兼容；bash test/compat/matrix.sh 跑多版本矩阵"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "react": "^18.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
